# Optional API key for Google Gemini generative AI orchestration.
# If omitted, the platform operates deterministically using the mathematical scoring engines.
GEMINI_API_KEY=

# Server port (defaults to 3000 if not specified)
PORT=3000

# Base URL of the deployment
APP_URL=http://localhost:3000

# Allowed CORS origins (comma-separated, or * for all)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional API key to protect mutating endpoints
STOCKAGENT_API_KEY=
